{
  "semi": false,
  "singleQuote": true,
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "importOrder": [
    "<BUILTIN_MODULES>",
    "",
    "^react$",
    "^react-dom$",
    "^react-router",
    "",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@/",
    "^[.]"
  ],
  "importOrderParserPlugins": ["jsx"],
  "importOrderCaseSensitive": false
}
